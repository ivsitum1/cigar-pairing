# izvorni Excel ostaje samo lokalno (svi podaci za app su u app/src/data/*.json)
*_Kolekcija_Checklist.xlsx
*Kolekcija_Checklist.xlsx
Konjak_Brandy_Checklist.xlsx
~$*.xlsx
# generirani indeksi (python app/scripts/export-indexes.py)
*_Index.xlsx

# secrets / local env
.env
**/.env
!.env.example
!**/.env.example

# python cache
__pycache__/

# agent / SDD working files
.superpowers/
.agent/memory/
agent-brain-lite/.agent/memory/
agent-brain-lite/.obsidian/workspace.json

# local git worktrees (full checkouts; must not pollute status)
.worktrees/

# OneDrive / Windows sync conflict copies (any extension)
*-DESKTOP-*
*DESKTOP-8FP2N9R*
.agent/MEMORY-DESKTOP-*
README-DESKTOP-*

# local scratch / backups / accidental root installs
.p3_backup/
01_work/output/
node_modules/
*.localbak
*.bak-local
*.bak_*

# YouTube scrape session cookies (never commit)
**/youtube/*cookies*
**/youtube/www.youtube.com_cookies*

# NotebookLM full grill dumps → commit on cursor/bonton-book-research-9b19
# (see docs/bonton/CROSSWALK.md). Keep only README on master.
docs/bonton/notebooklm-grill/*
!docs/bonton/notebooklm-grill/README.md

# NotebookLM studio book assets (large PNG/PPTX/PDF) — regenerable locally
docs/bonton/images/notebooklm-studio/*
!docs/bonton/images/notebooklm-studio/README.md
