# Local / test env for Vite (copy to `.env` or `.env.local` as needed).
# Never commit real secrets here — this app has none required.

# Age gate: set to 0 or off during QA so the overlay is skipped.
# Production / store builds: leave unset (gate ON) or set to 1.
# VITE_AGE_GATE=0

# Optional local Python PaddleOCR API (stronger on hard receipts).
# Leave unset on GitHub Pages — the PWA embeds @paddleocr/paddleocr-js instead.
# VITE_OCR_API_URL=http://127.0.0.1:8787
#
# Mora odgovarati OCR_API_TOKEN na servisu. Prazno na obje strane = bez
# provjere (u redu na 127.0.0.1); obavezno cim servis slusa na 0.0.0.0.
# VITE_OCR_API_TOKEN=
